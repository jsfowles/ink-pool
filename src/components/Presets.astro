---
import { PRESETS } from "../presets";
import Ink from "./Ink.astro";
---

<nav class="presets" aria-label="Presets">
  <div class="rail">
    <span class="preset-mark" id="preset-mark" aria-hidden="true"></span>
    <ul>
      {Object.entries(PRESETS).map(([name, { note }], i) => (
        <li style={`--i: ${i}`}>
          <button
            type="button"
            data-preset={name}
            data-note={note}
            aria-pressed="false"
          >
            <Ink text={name} />
          </button>
        </li>
      ))}
    </ul>
    <p class="preset-note" id="preset-note">
      <Ink />
    </p>
    <p class="preset-now" id="preset-now" aria-hidden="true">
      <Ink />
    </p>
  </div>
</nav>
