---
// A white copy blended by difference over a toned one blended by --lift:
// dark on the fog, light over a glyph, greyed by --tone.
type Props = { text?: string };

const { text = "" } = Astro.props;
---

<span class="ink-text">
  <span class="ink-a">{text}</span>
  <span class="ink-b" aria-hidden="true">
    {text}
  </span>
</span>
